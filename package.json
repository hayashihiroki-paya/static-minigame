{
  "name": "static-minigame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "test": "node --test",
    "pretest": "npm run build:same-game:wasm",
    "check:syntax": "node scripts/check-syntax.js",
    "check:types": "tsc --project tsconfig.json",
    "check": "npm run check:syntax && npm run check:types && npm test",
    "build": "vite build",
    "build:snake": "vite build --config vite.snake.config.js",
    "build:whack-a-mole": "vite build --config vite.whack-a-mole.config.js",
    "build:same-game:wasm": "wasm-pack build src/games/same-game --target web --release --no-opt --out-dir pkg --out-name same_game",
    "build:same-game": "npm run build:same-game:wasm && vite build --config vite.same-game.config.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "svelte": "^5.58.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
